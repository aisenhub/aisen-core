# Copy to apps/admin/.env.local (NOT the repository root .env).
# Start the local Supabase stack, then run `pnpm dlx supabase status`
# to get its Publishable Key. NEVER use sb_secret_ / service_role here.
# Restart `pnpm run dev` after changes.
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_LOCAL_PUBLISHABLE_KEY
